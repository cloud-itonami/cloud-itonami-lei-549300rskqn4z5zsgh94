} .livin-faq-section-wrapper .livin-faq-item.is-active .livin-faq-answer { max-height: 600px; /* Cukup besar untuk menampung konten */ padding: 0 25px 20px 25px; } /* Style untuk konten di dalam jawaban */ .livin-faq-section-wrapper .livin-faq-answer p, .livin-faq-section-wrapper .livin-faq-answer ul { margin: 0 0 15px 0; line-height: 1.7; color: #555; font-size: 15px; } .livin-faq-section-wrapper .livin-faq-answer p:last-child { margin-bottom: 0; } .livin-faq-section-wrapper .livin-faq-answer ul { padding-left: 20px; } .livin-faq-section-wrapper .livin-faq-answer li { margin-bottom: 8px; } .livin-faq-section-wrapper .livin-faq-answer a { color: #004dce; text-decoration: none; font-weight: 500; } .livin-faq-section-wrapper .livin-faq-answer a:hover { text-decoration: underline; } .lumba{ margin-left: 30px; list-style: circle; } Frequently Asked Questions (FAQ) Apa risiko penggunaan Livin' by Mandiri? + Risiko dalam bertransaksi digital dapat diminimalisir dengan cara: Gunakan perangkat yang mendukung agar pengalaman transaksi lebih lancar. Lakukan transaksi dengan koneksi internet yang stabil. Selalu perbarui aplikasi Livin’ agar mendapatkan fitur dan keamanan terbaru. Jaga kerahasiaan informasi pribadi dan jangan bagikan kode OTP, password, PIN, atau kredensial lainnya kepada siapa pun. Apa saja biaya yang dikenakan dalam penggunaan Livin' by Mandiri? + Dalam penggunaan Livin' by Mandiri, Anda dapat dikenakan biaya antara lain: Biaya terkait rekening, seperti biaya pembukaan rekening, biaya admin, dan biaya atas saldo minimum Biaya terkait kartu, seperti biaya pembuatan kartu debit fisik dan biaya administrasi kartu Biaya terkait penggunaan fitur, seperti biaya transaksi Informasi detail rekening simpanan dapat Anda lihat pada tautan berikut . Informasi biaya terkait penggunaan fitur dapat Anda lihat pada website Bank Mandiri terkait fitur dimaksud dan/atau pada aplikasi Livin' Anda. (function() { 'use strict'; // Cek apakah elemen wrapper ada di halaman sebelum menjalankan script const faqWrapper = document.querySelector('.livin-faq-accordion-wrapper'); if (!faqWrapper) { return; // Keluar jika tidak ditemukan } // Pilih semua tombol pertanyaan HANYA di dalam wrapper ini const faqQuestions = faqWrapper.querySelectorAll('.livin-faq-question'); faqQuestions.forEach(button => { button.addEventListener('click', () => { // Temukan item FAQ terkait (parent dari tombol) const currentItem = button.closest('.livin-faq-item'); const isActive = currentItem.classList.contains('is-active'); // Tutup semua item FAQ yang terbuka faqWrapper.querySelectorAll('.livin-faq-item.is-active').forEach(openItem => { openItem.classList.remove('is-active'); }); // Jika item yang diklik tadinya tidak aktif, buka sekarang if (!isActive) { currentItem.classList.add('is-active'); } }); }); })(); RIPLAY - LiVIN .pwc-section { max-width: 100%; margin: 0; padding: 0; box-sizing: border-box; } .pwc-section *, .pwc-section *::before, .pwc-section *::after { box-sizing: inherit; } /* ============================================ MAIN BANNER COMPONENT - Warna Bank Mandiri ============================================ */ /* Banner Container - menggunakan Mandiri Blue sebagai background utama */ .pwc-banner { position: relative; width: 100%; border-radius: 16px; overflow: hidden; background: linear-gradient(135deg, #003D7A 0%, #002B5C 100%); min-height: 240px; display: flex; align-items: center; justify-content: center; transition: box-shadow 0.2s ease, transform 0.2s ease; } /* Efek hover */ .pwc-banner--interactive:hover { transform: translateY(-2px); box-shadow: 0 20px 30px -12px rgba(0, 61, 122, 0.3); } /* Dekorasi Lingkungan - efek gelombang emas yang soft */ .pwc-banner::before { content: \"\"; position: absolute; width: 320px; height: 320px; top: -80px; left: -80px; background: radial-gradient(circle, rgba(255, 183, 0, 0.08) 0%, transparent 70%); border-radius: 50%; pointer-events: none; } .pwc-banner::after { content: \"\"; position: absolute; width: 280px; height: 280px; bottom: -70px; right: -50px; background: radial-gradient(circle, rgba(255, 183, 0, 0.06) 0%, transparent 70%); border-radius: 50%; pointer-events: none; } /* Content Wrapper */ .pwc-banner__content { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 40px 24px; text-align: center; width: 100%; } /* Badge - menggunakan Mandiri Yellow dengan sentuhan transparan */ .pwc-badge { display: inline-block; background: rgba(255, 183, 0, 0.12); backdrop-filter: blur(4px); padding: 4px 14px; border-radius: 40px; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; color: #FFB700; border: 1px solid rgba(255, 183, 0, 0.3); } /* Title Style - putih bersih */ .pwc-title { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 28px; font-weight: 700; line-height: 1.3; color: #FFFFFF; margin: 0; max-width: 720px; } /* Gaya untuk elemen Gelombang Emas di title (opsional) */ .pwc-title .pwc-gold { color: #C5A059; display: inline-block; } /* Subtitle / Deskripsi */ .pwc-description { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 0.95rem; font-weight: 400; line-height: 1.5; color: rgba(255, 255, 255, 0.85); margin: 0; max-width: 560px; } /* Tombol CTA - menggunakan Mandiri Yellow resmi */ .pwc-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background-color: #FFB700; color: #003D7A; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 1rem; font-weight: 700; line-height: 1.2; padding: 12px 32px; border-radius: 800px; text-decoration: none; transition: all 0.2s ease; box-shadow: 0 6px 14px rgba(255, 183, 0, 0.25); border: none; cursor: pointer; } .pwc-button:hover { background-color: #FFCD4A; transform: scale(1.02); box-shadow: 0 8px 20px rgba(255, 183, 0, 0.35); color: #002B5C; } .pwc-button:active { transform: scale(0.98); } /* Variasi tombol outline - dengan border kuning */ .pwc-button--outline { background: transparent; border: 2px solid #FFB700; color: #FFB700; box-shadow: none; } .pwc-button--outline:hover { background: rgba(255, 183, 0, 0.1); transform: scale(1.02); color: #FFD966; } /* Footer kecil dengan warna abu-abu Mandiri */ .pwc-footer-note { font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; font-size: 0.7rem; color: #B6B8BA; display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 4px; } .pwc-footer-note span { display: inline-flex; align-items: center; gap: 4px; } .pwc-dot { width: 3px; height: 3px; background-color: #B6B8BA; border-radius: 50%; } /* ============================================ VARIANT: Tema Langit (Sky Blue) - lebih soft ============================================ */ .pwc-banner--sky { background: linear-gradient(135deg, #67B2E8 0%, #3A8FC7 100%); } .pwc-banner--sky .pwc-title { color: #FFFFFF; } .pwc-banner--sky .pwc-badge { color: #FFB700; border-color: rgba(255, 183, 0, 0.4); } /* ============================================ VARIANT: Tema Orange (secondary) ============================================ */ .pwc-banner--orange { background: linear-gradient(135deg, #EA7200 0%, #C55A00 100%); } /* ============================================ VARIANT: Tema Premium (Gold) - untuk produk prioritas ============================================ */ .pwc-banner--gold { background: linear-gradient(135deg, #1A2A3A 0%, #0F1722 100%); } .pwc-banner--gold .pwc-title .pwc-gold { color: #C5A059; } /* ============================================ VARIANT: Ukuran Compact ============================================ */ .pwc-banner--compact { min-height: 180px; } .pwc-banner--compact .pwc-banner__content { padding: 24px 20px; gap: 12px; } .pwc-banner--compact .pwc-title { font-size: 22px; } .pwc-banner--compact .pwc-button { padding: 8px 24px; font-size: 0.9rem; } /* ============================================ VARIANT: Light - latar putih (untuk inverse logo) ============================================ */ .pwc-banner--light { background: linear-gradient(135deg, #F5F7F9 0%, #EBEEF2 100%); } .pwc-banner--light .pwc-title { color: #003D7A; } .pwc-banner--light .pwc-description { color: #4A5568; } .pwc-banner--light .pwc-footer-note { color: #718096; } .pwc-banner--light .pwc-badge { color: #EA7200; border-color: rgba(234, 114, 0, 0.3); background: rgba(0, 0, 0, 0.04); } /* ============================================ RESPONSIVE ADJUSTMENTS ============================================ */ @media (max-width: 768px) { .pwc-banner { min-height: auto; } .pwc-banner__content { padding: 32px 20px; gap: 14px; } .pwc-title { font-size: 22px; line-height: 1.35; } .pwc-description { font-size: 0.85rem; padding: 0 8px; } .pwc-button { font-size: 0.9rem; padding: 10px 28px; } .pwc-footer-note { font-size: 0.65rem; gap: 8px; } } @media (max-width: 480px) { .pwc-title { font-size: 18px; } .pwc-banner__content { padding: 28px 16px; } .pwc-button { width: 100%; max-width: 220px; justify-content: center; } } /* ============================================ UTILITY ============================================ */ .pwc-banner--no-decoration::before, .pwc-banner--no-decoration::after { display: none; } RIPLAY Ringkasan Informasi Produk dan Layanan (RIPLAY) Informasi lengkap mengenai Livin' by Mandiri Lihat Detail .footer-bottom .container { padding-top: 50px; padding-bottom: 50px; } .fa-ag-liv-call { display: flex; width: 18px !important; content: url(https://bankmandiri.co.id/documents/20143/32404/Icon+Infoband+Livin+Call-02.png/82ba8840-b79c-3c2e-e751-64fdb3e25dcb?t=1781007421162); } Kantor Pusat Menara Mandiri 1 Jalan Jenderal Sudirman Kav 54-55 Jakarta 12190 Indonesia Telp: 14000, +62-21-52997777 Ema